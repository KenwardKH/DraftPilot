# ==============================================================================
# Interactive AI Project Workspace — Environment Variables Example
# Copy this file to `.env.local` to configure your host settings.
# ==============================================================================

# Local AI Gateway / 9Router Configuration (Host Defaults)
# By default, points to your locally running 9Router proxy
AI_BASE_URL="http://localhost:20128/v1"
AI_API_KEY="sk-9router"
AI_MODEL="gemini-2.5-flash"

# Optional Tunnel Security Passcode
# If left empty/unset, the workspace opens immediately with zero login friction.
# If set, visitors via tunnels must submit this passcode once to unlock API routes.
WORKSPACE_PASSCODE=""

# Next.js Server Port (Default: 3000)
PORT=3000

